{
  "name": "photo-desktop-pet",
  "version": "1.1.20",
  "private": true,
  "description": "Photo Desktop Pet for macOS",
  "main": "main.js",
  "scripts": {
    "verify": "node scripts/verify-app.js .",
    "verify:electron-runtime": "electron -e \"require('sharp'); console.log('sharp runtime ok:', process.versions.node)\"",
    "dist:mac": "electron-builder --mac dmg --x64 --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "onnxruntime-node": "1.17.3",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "electron": "30.0.0",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.laofutsit.photo-desktop-pet",
    "productName": "Photo Desktop Pet",
    "asar": true,
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/sharp-darwin-x64/**/*",
      "node_modules/@img/sharp-libvips-darwin-x64/**/*",
      "node_modules/@img/sharp-win32-x64/**/*",
      "node_modules/onnxruntime-node/**/*"
    ],
    "files": [
      "**/*",
      "!node_modules/.cache/**"
    ],
    "artifactName": "photo-desktop-pet-${version}-mac-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "identity": null
    },
    "win": {
      "icon": "assets/icon.ico",
      "executableName": "照片桌宠",
      "artifactName": "photo-desktop-pet-${version}-Windows-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "照片桌宠"
    },
    "dmg": {
      "icon": "assets/icon.icns"
    }
  }
}
